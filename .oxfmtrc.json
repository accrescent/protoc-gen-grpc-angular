{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "overrides": [
        {
            "files": ["*.yaml"],
            "options": {
                "singleQuote": true,
                "tabWidth": 2
            }
        }
    ],
    "sortPackageJson": {
        "sortScripts": true
    },
    "tabWidth": 4
}
